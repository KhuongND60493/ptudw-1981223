<div class="breadcrumb-wrap">
    <div class="container">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item"><a href="#">User</a></li>
            <li class="breadcrumb-item active">Login</li>
        </ul>
    </div>
</div>

<div class="login">
    <div class="container">
        <div class="section-header">
            <h3>Forgot Password</h3>
            {{# if forgotDone}}
                <p>
                    An email has been sent to your email. Please follow the instruction in that email to reset your
                    password
                </p>
            {{else}}
                <p>
                    Enter your email and we'll send you the instruction.
                </p>
            {{/if}}

        </div>
        {{#unless forgotDone}}
            <div class="row">
                <div class="col-md-6">
                    <form action="/users/forgot" method="post" id="formForgot">
                        <div class="register-form">
                            <div class="row">
                                <div class="col-md-6 justify-content-md-center">
                                    <label>E-mail</label>
                                    <input class="form-control" type="text" name="email" placeholder="E-mail"
                                           pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$" required>
                                </div>
                                <div class="col-md-12">
                                    <button class="btn">Submit</button>
                                </div>
                                {{#if forgotMessage}}
                                    <div class="col-md-12">
                                        <div class="p-3 mt-3 alert-warning">
                                            {{forgotMessage}}
                                        </div>
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        {{/unless}}
    </div>
</div>
